---
import type { TeamMember } from '../data/team';
import Icon from './Icon.astro';

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
---

<article class="team-card card card-glass" style={`--member-accent: ${member.accentColor};`}>
  <div class="team-card-top">
    <!-- Stylized Avatar -->
    <div class="team-avatar-box" style={`background: ${member.themeColor}; border-color: ${member.accentColor}40;`}>
      <span class="avatar-initials" style={`color: ${member.accentColor};`}>{member.avatarInitials}</span>
    </div>

    <!-- Socials -->
    <div class="team-socials">
      {member.socials.map((s) => (
        <a
          href={s.url}
          target="_blank"
          rel="noopener noreferrer"
          class="team-social-link"
          aria-label={`${member.name} on ${s.platform}`}
        >
          <Icon name={s.icon as any} size={15} />
        </a>
      ))}
    </div>
  </div>

  <div class="team-card-info">
    <span class="team-dept-badge">{member.department}</span>
    <h3 class="team-name">{member.name}</h3>
    <p class="team-role">{member.role}</p>
    <p class="team-bio-snippet">{member.bio.slice(0, 115)}...</p>

    <!-- Specializations -->
    <div class="team-specs-list">
      {member.specializations.slice(0, 3).map((spec) => (
        <span class="team-spec-tag">{spec}</span>
      ))}
    </div>
  </div>

  <div class="team-card-footer">
    <button
      type="button"
      class="btn btn-secondary btn-sm btn-full open-team-modal-btn"
      data-team-trigger
      data-name={member.name}
      data-role={member.role}
      data-department={member.department}
      data-avatar={member.avatarInitials}
      data-bio={member.bio}
      data-specs={member.specializations.join(', ')}
      data-accolades={member.accolades.join(', ')}
      data-quote={member.favoriteQuote}
      data-color={member.themeColor}
    >
      <Icon name="eye" size={14} />
      <span>View Full Bio & Awards</span>
    </button>
  </div>
</article>

<style>
  .team-card {
    display: flex;
    flex-direction: column;
    padding: 2rem 1.75rem;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    background: var(--bg-surface);
    transition: transform var(--transition-normal), border-color var(--transition-normal), box-shadow var(--transition-normal);
  }

  .team-card:hover {
    transform: translateY(-5px);
    border-color: var(--member-accent);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.12);
  }

  .team-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .team-avatar-box {
    width: 68px;
    height: 68px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-sm);
  }

  .avatar-initials {
    font-size: 1.5rem;
    font-weight: 800;
    font-family: var(--font-mono);
  }

  .team-socials {
    display: flex;
    gap: 0.4rem;
  }

  .team-social-link {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: all var(--transition-fast);
  }

  .team-social-link:hover {
    color: var(--text-primary);
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }

  .team-card-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    margin-bottom: 1.5rem;
  }

  .team-dept-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand-primary);
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .team-name {
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .team-role {
    font-size: 0.88rem;
    color: var(--text-secondary);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .team-bio-snippet {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }

  .team-specs-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }

  .team-spec-tag {
    font-size: 0.74rem;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
  }

  .team-card-footer {
    margin-top: auto;
  }
</style>
