---
import { getRelativePath } from '../data/site';
import Icon from './Icon.astro';
---

<section class="hero-section">
  <!-- Ambient background glow elements -->
  <div class="ambient-glow glow-1"></div>
  <div class="ambient-glow glow-2"></div>

  <div class="container hero-container">
    <!-- Top Pill -->
    <div class="hero-badge-wrap">
      <span class="section-tag hero-badge">
        <Icon name="sparkle" size={14} />
        <span>Venture Digital Studio • 2026 Edition</span>
      </span>
    </div>

    <!-- Main Headline -->
    <h1 class="hero-headline">
      We Architect <span class="gradient-text">High-Impact</span> Digital Products & Iconic Brands.
    </h1>

    <!-- Hero Subtitle -->
    <p class="hero-subtitle">
      Apex is a multidisciplinary creative engineering agency. We fuse rigorous product architecture, kinetic design systems, and zero-bloat web engineering to help category leaders dominate digital spaces.
    </p>

    <!-- CTAs -->
    <div class="hero-actions">
      <a href={getRelativePath('/projects/')} class="btn btn-primary btn-lg btn-glow">
        <span>Explore Selected Work</span>
        <Icon name="arrow-right" size={18} />
      </a>
      <button type="button" class="btn btn-secondary btn-lg open-contact-modal-btn" data-contact-trigger>
        <Icon name="mail" size={18} />
        <span>Book Discovery Call</span>
      </button>
    </div>

    <!-- Key Metrics Pills -->
    <div class="hero-metrics-bar">
      <div class="metric-pill">
        <Icon name="trophy" size={16} class="metric-icon" />
        <span class="metric-text"><strong>42</strong> Design & Tech Awards</span>
      </div>
      <div class="metric-divider"></div>
      <div class="metric-pill">
        <Icon name="zap" size={16} class="metric-icon" />
        <span class="metric-text"><strong>&lt; 0.4s</strong> Sub-Second Speed</span>
      </div>
      <div class="metric-divider"></div>
      <div class="metric-pill">
        <Icon name="shield" size={16} class="metric-icon" />
        <span class="metric-text"><strong>$480M+</strong> Client Value Created</span>
      </div>
    </div>

    <!-- Interactive Agency Canvas Showcase Preview Graphic -->
    <div class="hero-canvas-wrapper card card-glass">
      <div class="canvas-header">
        <div class="canvas-window-dots">
          <span class="dot dot-red"></span>
          <span class="dot dot-yellow"></span>
          <span class="dot dot-green"></span>
        </div>
        <div class="canvas-address-bar">
          <span class="lock-icon">🔒</span>
          <span class="address-text">apexagency.dev/flagship-workspace</span>
        </div>
        <div class="canvas-mode-badge">
          <span class="live-indicator"></span>
          <span>LIVE WORKSPACE</span>
        </div>
      </div>

      <div class="canvas-viewport">
        <!-- Interactive Mockup Reel -->
        <div class="mockup-grid">
          <div class="mockup-column left-col">
            <div class="mockup-box card-box highlight-box">
              <div class="box-tag">Synthetix AI Workspace</div>
              <h3 class="box-title">Spatial Autonomous Canvas</h3>
              <p class="box-desc">Replaced legacy compute notebooks with a zero-latency graph engine.</p>
              <div class="metric-badge-row">
                <span class="badge badge-brand">+340% User Growth</span>
                <span class="badge badge-success">4.2x Velocity</span>
              </div>
            </div>

            <div class="mockup-box card-box secondary-box">
              <div class="box-tag">Veloce Cloud Platform</div>
              <h3 class="box-title">Sub-50ms Global Edge Portal</h3>
              <div class="code-snippet-preview">
                <code>$ apex deploy --region global --perf 100/100</code>
                <span class="status-ok">✔ Ready</span>
              </div>
            </div>
          </div>

          <div class="mockup-column right-col">
            <div class="mockup-box card-box visual-box">
              <div class="visual-accent-mesh">
                <div class="mesh-orb orb-1"></div>
                <div class="mesh-orb orb-2"></div>
                <div class="wireframe-lines">
                  <div class="w-line l-1"></div>
                  <div class="w-line l-2"></div>
                  <div class="w-line l-3"></div>
                </div>
              </div>
              <div class="visual-content">
                <span class="badge badge-purple">Spatial 3D & WebGL</span>
                <h4 class="visual-title">Aurora Acoustic Engine</h4>
                <p class="visual-caption">Real-time binaural spatial audio playground built in the browser.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-top: clamp(3.5rem, 7vw, 6.5rem);
    padding-bottom: 5rem;
    overflow: hidden;
  }

  /* Ambient Glow Orbs */
  .ambient-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    z-index: -1;
    pointer-events: none;
    opacity: 0.45;
  }

  .glow-1 {
    top: -10%;
    left: 20%;
    width: 600px;
    height: 500px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.4) 0%, transparent 70%);
  }

  .glow-2 {
    top: 20%;
    right: 15%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(6, 182, 212, 0.3) 0%, transparent 70%);
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-badge-wrap {
    margin-bottom: 1.5rem;
  }

  .hero-badge {
    background: rgba(99, 102, 241, 0.12);
    border-color: rgba(99, 102, 241, 0.3);
  }

  .hero-headline {
    font-size: clamp(2.4rem, 5.5vw, 4.4rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.08;
    max-width: 980px;
    margin-bottom: 1.5rem;
    color: var(--text-primary);
  }

  .hero-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    color: var(--text-muted);
    line-height: 1.65;
    max-width: 780px;
    margin-bottom: 2.5rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }

  /* Metrics Bar */
  .hero-metrics-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    padding: 0.75rem 1.75rem;
    border-radius: var(--radius-full);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-sm);
    margin-bottom: 4rem;
  }

  .metric-pill {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .metric-icon {
    color: var(--brand-primary);
  }

  .metric-pill strong {
    color: var(--text-primary);
    font-weight: 700;
  }

  .metric-divider {
    display: none;
    width: 1px;
    height: 16px;
    background: var(--border-strong);
  }

  @media (min-width: 680px) {
    .metric-divider {
      display: block;
    }
  }

  /* Canvas Showcase Box */
  .hero-canvas-wrapper {
    width: 100%;
    max-width: 1120px;
    padding: 0;
    overflow: hidden;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl), 0 0 60px rgba(99, 102, 241, 0.15);
  }

  .canvas-header {
    background: var(--bg-surface-elevated);
    border-bottom: 1px solid var(--border-subtle);
    padding: 0.85rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .canvas-window-dots {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot-red { background: #ef4444; }
  .dot-yellow { background: #f59e0b; }
  .dot-green { background: #10b981; }

  .canvas-address-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-sm);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .lock-icon {
    font-size: 0.75rem;
  }

  .canvas-mode-badge {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-success);
  }

  .live-indicator {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 8px var(--color-success);
  }

  .canvas-viewport {
    padding: 1.5rem;
    background: var(--bg-body);
  }

  @media (min-width: 768px) {
    .canvas-viewport {
      padding: 2.25rem;
    }
  }

  .mockup-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 860px) {
    .mockup-grid {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .mockup-column {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .card-box {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    text-align: left;
    position: relative;
    overflow: hidden;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .card-box:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
  }

  .highlight-box {
    border-left: 4px solid var(--brand-primary);
  }

  .box-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand-primary);
    margin-bottom: 0.5rem;
  }

  .box-title {
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 0.65rem;
  }

  .box-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }

  .metric-badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .secondary-box {
    background: var(--bg-surface-elevated);
  }

  .code-snippet-preview {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 0.95rem;
    border-radius: var(--radius-sm);
    background: var(--bg-body);
    border: 1px solid var(--border-subtle);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-secondary);
    margin-top: 0.85rem;
  }

  .status-ok {
    color: var(--color-success);
    font-weight: 700;
  }

  .visual-box {
    height: 100%;
    min-height: 260px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: linear-gradient(180deg, rgba(168, 85, 247, 0.08) 0%, rgba(99, 102, 241, 0.15) 100%);
    border-color: rgba(168, 85, 247, 0.25);
  }

  .visual-accent-mesh {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .mesh-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(40px);
  }

  .orb-1 {
    top: 10%;
    right: 15%;
    width: 140px;
    height: 140px;
    background: rgba(168, 85, 247, 0.5);
  }

  .orb-2 {
    bottom: 20%;
    left: 10%;
    width: 160px;
    height: 160px;
    background: rgba(6, 182, 212, 0.4);
  }

  .visual-content {
    position: relative;
    z-index: 1;
  }

  .visual-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-top: 0.65rem;
    margin-bottom: 0.35rem;
  }

  .visual-caption {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
</style>
