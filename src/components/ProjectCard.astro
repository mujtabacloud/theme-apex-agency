---
import type { Project } from '../data/projects';
import Icon from './Icon.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article
  class="project-card card card-glass"
  data-project-item
  data-category={project.category}
  style={`--proj-accent: ${project.accentColor}; --proj-theme: ${project.themeColor};`}
>
  <!-- Card Header Visual Mockup -->
  <div class="project-preview-canvas">
    <div class="canvas-topbar">
      <div class="canvas-dots">
        <span></span><span></span><span></span>
      </div>
      <span class="canvas-client-url">{project.client.toLowerCase().replace(/[^a-z0-9]/g, '')}.com</span>
    </div>

    <div class="canvas-visual-body">
      <div class="visual-badge-pill">
        <span class="pill-dot"></span>
        <span>{project.category}</span>
      </div>
      <div class="visual-headline">{project.title}</div>
      <div class="visual-metric-highlight">
        <span class="metric-num">{project.metrics[0].value}</span>
        <span class="metric-txt">{project.metrics[0].label}</span>
      </div>
    </div>
  </div>

  <!-- Card Body -->
  <div class="project-card-body">
    <div class="project-meta-row">
      <span class="client-name">{project.client}</span>
      <span class="project-year">{project.year}</span>
    </div>

    <h3 class="project-title">{project.title}</h3>
    <p class="project-tagline">{project.tagline}</p>
    <p class="project-desc">{project.description}</p>

    <!-- Metrics Row -->
    <div class="project-metrics-grid">
      {project.metrics.map((metric) => (
        <div class="metric-box">
          <span class="metric-val">{metric.value}</span>
          <span class="metric-lbl">{metric.label}</span>
        </div>
      ))}
    </div>

    <!-- Executive Quote -->
    <blockquote class="client-quote">
      <p class="quote-text">“{project.testimonial.quote}”</p>
      <footer class="quote-author">
        — {project.testimonial.author}, <span class="author-role">{project.testimonial.role}</span>
      </footer>
    </blockquote>

    <!-- Deliverables Tags -->
    <div class="deliverables-wrap">
      {project.deliverables.slice(0, 3).map((item) => (
        <span class="deliverable-tag">{item}</span>
      ))}
    </div>

    <!-- Card Action -->
    <div class="project-card-footer">
      <button
        type="button"
        class="btn btn-secondary btn-sm btn-full open-contact-modal-btn"
        data-contact-trigger
      >
        <span>Discuss Similar Project</span>
        <Icon name="arrow-up-right" size={14} />
      </button>
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    background: var(--bg-surface);
    transition: transform var(--transition-normal), border-color var(--transition-normal), box-shadow var(--transition-normal);
  }

  .project-card:hover {
    transform: translateY(-6px);
    border-color: var(--proj-accent);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
  }

  /* Visual Canvas */
  .project-preview-canvas {
    background: var(--proj-theme, #0c1220);
    padding: 1.25rem 1.5rem;
    height: 220px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    border-bottom: 1px solid var(--border-subtle);
    overflow: hidden;
  }

  .project-preview-canvas::after {
    content: '';
    position: absolute;
    bottom: -30%;
    right: -10%;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: var(--proj-accent);
    filter: blur(60px);
    opacity: 0.35;
    pointer-events: none;
  }

  .canvas-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: rgba(255, 255, 255, 0.55);
    position: relative;
    z-index: 1;
  }

  .canvas-dots {
    display: flex;
    gap: 5px;
  }

  .canvas-dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
  }

  .canvas-visual-body {
    position: relative;
    z-index: 1;
  }

  .visual-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.12);
    color: #ffffff;
    margin-bottom: 0.5rem;
  }

  .pill-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--proj-accent);
  }

  .visual-headline {
    font-size: 1.35rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-bottom: 0.5rem;
  }

  .visual-metric-highlight {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
  }

  .metric-num {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--proj-accent);
  }

  .metric-txt {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.7);
  }

  /* Body */
  .project-card-body {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .project-meta-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.82rem;
    font-family: var(--font-mono);
    color: var(--text-subtle);
    margin-bottom: 0.5rem;
  }

  .client-name {
    font-weight: 700;
    color: var(--brand-primary);
  }

  .project-title {
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 0.45rem;
  }

  .project-tagline {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-secondary);
    line-height: 1.45;
    margin-bottom: 0.85rem;
  }

  .project-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  /* Metrics Grid */
  .project-metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.65rem;
    padding: 0.95rem 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 1.25rem;
    text-align: center;
  }

  .metric-box {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .metric-val {
    font-size: 1rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .metric-lbl {
    font-size: 0.72rem;
    color: var(--text-subtle);
    line-height: 1.3;
  }

  /* Quote */
  .client-quote {
    margin-bottom: 1.25rem;
    padding-left: 0.85rem;
    border-left: 2px solid var(--proj-accent);
    font-style: italic;
  }

  .quote-text {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 0.35rem;
  }

  .quote-author {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-style: normal;
  }

  .author-role {
    color: var(--text-subtle);
  }

  /* Deliverables */
  .deliverables-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }

  .deliverable-tag {
    font-size: 0.75rem;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-xs);
    background: var(--bg-surface-elevated);
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
  }

  .project-card-footer {
    margin-top: auto;
  }
</style>
