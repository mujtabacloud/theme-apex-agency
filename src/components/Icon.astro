---
interface Props {
  name:
    | 'sun'
    | 'moon'
    | 'arrow-right'
    | 'arrow-up-right'
    | 'arrow-left'
    | 'check'
    | 'external-link'
    | 'star'
    | 'github'
    | 'twitter'
    | 'linkedin'
    | 'mail'
    | 'phone'
    | 'map-pin'
    | 'close'
    | 'menu'
    | 'filter'
    | 'sparkle'
    | 'layers'
    | 'cpu'
    | 'layout'
    | 'code'
    | 'shield'
    | 'zap'
    | 'users'
    | 'trophy'
    | 'clock'
    | 'eye';
  size?: number | string;
  class?: string;
}

const { name, size = 18, class: className = '' } = Astro.props;
const dimension = typeof size === 'number' ? `${size}px` : size;
---

<span class={`icon-wrapper ${className}`} style={`width: ${dimension}; height: ${dimension}; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0;`}>
