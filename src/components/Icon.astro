      <path d="m19.07 4.93-1.41 1.41"></path>
    </svg>
  )}

  {name === 'moon' && (
    <svg width={dimension} height={dimension} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
