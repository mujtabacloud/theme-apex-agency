---
import { services } from '../data/services';
import ServiceCard from './ServiceCard.astro';
---

<section class="services-section" id="services">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">End-to-End Capabilities</span>
      <h2 class="section-title">Full-spectrum execution for high-growth ventures.</h2>
      <p class="section-subtitle">
        From strategic product architecture to zero-bloat web engineering, our multidisciplinary teams deliver cohesive digital systems built to endure.
      </p>
    </div>

    <div class="grid grid-3 services-grid">
      {services.map((service) => (
        <ServiceCard service={service} />
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    padding: 6.5rem 0;
    position: relative;
    background: var(--bg-surface-subtle);
  }

  .services-grid {
    gap: 2rem;
  }
</style>
