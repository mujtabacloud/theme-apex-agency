---
import Icon from './Icon.astro';

const budgetTiers = [
  { id: 'b1', label: '< $25k', desc: 'Fast-Track Sprint' },
  { id: 'b2', label: '$25k - $50k', desc: 'Core MVP / Rebrand' },
  { id: 'b3', label: '$50k - $100k', desc: 'Comprehensive Platform' },
  { id: 'b4', label: '$100k+', desc: 'Enterprise Ecosystem' },
];

const serviceOptions = [
  'Digital Product Design',
  'Next-Gen Web Architecture',
  'Brand & Motion Identity',
  'Design Systems & Tokens',
  '3D Spatial & WebGL',
  'Growth & Performance SEO',
];
---

<div id="contact-modal" class="modal-overlay" aria-hidden="true" role="dialog" aria-labelledby="contact-modal-title">
  <div class="modal-window">
    <button type="button" class="modal-close-btn" id="close-contact-modal" aria-label="Close contact dialog">
      <Icon name="close" size={18} />
    </button>

    <!-- Modal Form Content -->
    <div id="contact-form-container">
      <div class="modal-header">
        <span class="badge badge-brand">Project Inquiry</span>
        <h2 id="contact-modal-title" class="modal-title">Let’s engineer something iconic.</h2>
        <p class="modal-subtitle">
          Tell us about your timeline, vision, and scale. We typically reply within 24 business hours.
        </p>

        <!-- Demo Mode Notice -->
        <div class="demo-disclaimer-box">
          <div class="disclaimer-header">
            <Icon name="shield" size={16} class="text-indigo" />
            <span class="disclaimer-title">Theme Demo Mode</span>
          </div>
          <p class="disclaimer-text">
            This contact form simulates complete client-side validation and submission. In production, easily connect it to Formspree, Basin, Netlify Forms, or your custom backend API.
          </p>
        </div>
      </div>

      <form id="apex-inquiry-form" class="inquiry-form" novalidate>
        <!-- Budget Selector -->
        <div class="form-group">
          <label class="form-label">Estimated Project Investment</label>
          <div class="budget-grid" role="radiogroup" aria-label="Project budget selector">
            {budgetTiers.map((tier, index) => (
              <label class={`budget-pill-label ${index === 1 ? 'selected' : ''}`}>
                <input
                  type="radio"
                  name="budget"
                  value={tier.label}
                  class="budget-radio sr-only"
                  checked={index === 1}
                />
                <span class="pill-amount">{tier.label}</span>
                <span class="pill-desc">{tier.desc}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Services Needed Checkboxes -->
        <div class="form-group">
          <label class="form-label">Areas of Interest (Select all that apply)</label>
          <div class="services-checkbox-grid">
            {serviceOptions.map((service, idx) => (
              <label class="service-check-label">
                <input
                  type="checkbox"
                  name="services"
                  value={service}
                  class="service-checkbox"
                  checked={idx < 2}
                />
                <span class="check-box-custom"></span>
                <span class="check-text">{service}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- User Information Fields -->
        <div class="form-row">
          <div class="form-group half">
            <label for="inquiry-name" class="form-label">Your Name <span class="req">*</span></label>
            <input
              type="text"
              id="inquiry-name"
              name="name"
              class="form-input"
              placeholder="e.g. Maya Lin"
              required
            />
            <span class="field-error" id="err-name"></span>
          </div>

          <div class="form-group half">
            <label for="inquiry-email" class="form-label">Work Email <span class="req">*</span></label>
            <input
              type="email"
              id="inquiry-email"
              name="email"
              class="form-input"
              placeholder="maya@company.com"
              required
            />
            <span class="field-error" id="err-email"></span>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group half">
            <label for="inquiry-company" class="form-label">Company / Venture</label>
            <input
              type="text"
              id="inquiry-company"
              name="company"
              class="form-input"
              placeholder="e.g. Synthetix Labs"
            />
          </div>

          <div class="form-group half">
            <label for="inquiry-timeline" class="form-label">Desired Launch Timeline</label>
            <select id="inquiry-timeline" name="timeline" class="form-select">
              <option value="Immediately (Next 2-4 Weeks)">Immediately (Next 2-4 Weeks)</option>
              <option value="Q2 Launch (1-3 Months)" selected>Q2 Launch (1-3 Months)</option>
              <option value="Longer Horizon (3-6 Months)">Longer Horizon (3-6 Months)</option>
              <option value="Strategic Advisory / Retainer">Strategic Advisory / Retainer</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label for="inquiry-message" class="form-label">Project Overview <span class="req">*</span></label>
          <textarea
            id="inquiry-message"
            name="message"
            rows="3"
            class="form-textarea"
            placeholder="Tell us what you are building, the audience you serve, and key outcomes you expect..."
            required
          ></textarea>
          <span class="field-error" id="err-message"></span>
        </div>

        <!-- Submit Button -->
        <div class="form-actions">
          <button type="submit" class="btn btn-primary btn-lg btn-full" id="submit-inquiry-btn">
            <span>Send Project Inquiry</span>
            <Icon name="arrow-right" size={18} />
          </button>
        </div>
      </form>
    </div>

    <!-- Success Confirmation State (Hidden initially) -->
    <div id="contact-success-container" class="success-view" hidden>
      <div class="success-icon-wrap">
        <Icon name="check" size={32} />
      </div>
      <h3 class="success-title">Inquiry Received!</h3>
      <p class="success-desc">
        Thank you for reaching out to Apex Agency. Our partner team will review your specifications and schedule a discovery call within one business day.
      </p>
      <div class="success-summary card">
        <div class="summary-item">
          <span class="summary-label">Contact:</span>
          <span class="summary-val" id="summary-name"></span>
        </div>
        <div class="summary-item">
          <span class="summary-label">Email:</span>
          <span class="summary-val" id="summary-email"></span>
        </div>
        <div class="summary-item">
          <span class="summary-label">Budget Tier:</span>
          <span class="summary-val" id="summary-budget"></span>
        </div>
      </div>
      <button type="button" class="btn btn-secondary btn-full" id="reset-contact-form-btn">
        <span>Send Another Message</span>
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const modal = document.getElementById('contact-modal');
    const closeBtn = document.getElementById('close-contact-modal');
    const formContainer = document.getElementById('contact-form-container');
    const successContainer = document.getElementById('contact-success-container');
    const form = document.getElementById('apex-inquiry-form');
    const resetBtn = document.getElementById('reset-contact-form-btn');

    // Open Modal Triggers
    function openModal() {
      if (!modal) return;
      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      // Focus first input
      setTimeout(() => {
        const firstInput = modal.querySelector('input:not([type="radio"]):not([type="checkbox"])');
        if (firstInput) firstInput.focus();
      }, 100);
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    // Attach to all elements with [data-contact-trigger]
    document.querySelectorAll('[data-contact-trigger]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        openModal();
      });
    });

    if (closeBtn) closeBtn.addEventListener('click', closeModal);

    // Close on backdrop click
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && modal.classList.contains('open')) {
        closeModal();
      }
    });

    // Budget Radio Styling
    const budgetLabels = modal?.querySelectorAll('.budget-pill-label');
    budgetLabels?.forEach((label) => {
      label.addEventListener('click', () => {
        budgetLabels.forEach((l) => l.classList.remove('selected'));
        label.classList.add('selected');
      });
    });

    // Form Validation & Submission
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        let isValid = true;

        const nameInput = document.getElementById('inquiry-name');
        const emailInput = document.getElementById('inquiry-email');
        const msgInput = document.getElementById('inquiry-message');

        const errName = document.getElementById('err-name');
        const errEmail = document.getElementById('err-email');
        const errMessage = document.getElementById('err-message');

        // Reset errors
        [errName, errEmail, errMessage].forEach((el) => {
          if (el) el.textContent = '';
        });

        if (!nameInput.value.trim()) {
          errName.textContent = 'Please enter your name.';
          isValid = false;
        }

        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailInput.value.trim() || !emailRegex.test(emailInput.value.trim())) {
          errEmail.textContent = 'Please enter a valid work email address.';
          isValid = false;
        }

        if (!msgInput.value.trim() || msgInput.value.trim().length < 10) {
          errMessage.textContent = 'Please provide a brief overview (min 10 characters).';
          isValid = false;
        }

        if (isValid) {
          const selectedBudget = form.querySelector('input[name="budget"]:checked')?.value || '$25k - $50k';
          
          document.getElementById('summary-name').textContent = nameInput.value.trim();
          document.getElementById('summary-email').textContent = emailInput.value.trim();
          document.getElementById('summary-budget').textContent = selectedBudget;

          formContainer.hidden = true;
          successContainer.hidden = false;
        }
      });
    }

    // Reset Form
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        form.reset();
        formContainer.hidden = false;
        successContainer.hidden = true;
      });
    }
  })();
</script>

<style>
  .modal-header {
    margin-bottom: 1.75rem;
  }

  .modal-title {
    font-size: 1.75rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.25;
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
    color: var(--text-primary);
  }

  .modal-subtitle {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  /* Disclaimer Box */
  .demo-disclaimer-box {
    margin-top: 1rem;
    padding: 0.85rem 1.15rem;
    border-radius: var(--radius-md);
    background: rgba(99, 102, 241, 0.08);
    border: 1px solid rgba(99, 102, 241, 0.2);
  }

  .disclaimer-header {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin-bottom: 0.25rem;
  }

  .disclaimer-title {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--brand-primary);
  }

  .disclaimer-text {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.45;
  }

  /* Form Elements */
  .inquiry-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .form-row {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 600px) {
    .form-row {
      flex-direction: row;
    }
    .form-group.half {
      flex: 1;
    }
  }

  .form-label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .req {
    color: var(--color-danger);
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    padding: 0.7rem 0.95rem;
    border-radius: var(--radius-md);
    background: var(--bg-input);
    border: 1px solid var(--border-strong);
    color: var(--text-primary);
    font-size: 0.93rem;
    transition: all var(--transition-fast);
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--brand-primary);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
  }

  .field-error {
    font-size: 0.8rem;
    color: var(--color-danger);
    font-weight: 500;
  }

  /* Budget Radio Pills */
  .budget-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.65rem;
  }

  @media (min-width: 540px) {
    .budget-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .budget-pill-label {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0.65rem 0.5rem;
    border-radius: var(--radius-md);
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    cursor: pointer;
    transition: all var(--transition-fast);
    text-align: center;
  }

  .budget-pill-label:hover {
    border-color: var(--border-hover);
  }

  .budget-pill-label.selected {
    background: rgba(99, 102, 241, 0.12);
    border-color: var(--brand-primary);
    box-shadow: 0 0 0 1px var(--brand-primary);
  }

  .pill-amount {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .pill-desc {
    font-size: 0.7rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  /* Services Checkbox Grid */
  .services-checkbox-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 0.55rem;
  }

  @media (min-width: 500px) {
    .services-checkbox-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .service-check-label {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    cursor: pointer;
    font-size: 0.85rem;
    color: var(--text-secondary);
    transition: all var(--transition-fast);
  }

  .service-check-label:hover {
    color: var(--text-primary);
    border-color: var(--border-hover);
  }

  .service-checkbox {
    accent-color: var(--brand-primary);
    width: 16px;
    height: 16px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  /* Success View */
  .success-view {
    text-align: center;
    padding: 2rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .success-icon-wrap {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-full);
    background: rgba(16, 185, 129, 0.15);
    color: var(--color-success);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .success-title {
    font-size: 1.85rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .success-desc {
    font-size: 0.98rem;
    color: var(--text-muted);
    max-width: 440px;
    line-height: 1.6;
  }

  .success-summary {
    width: 100%;
    background: var(--bg-surface-elevated);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    text-align: left;
  }

  .summary-item {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
  }

  .summary-label {
    color: var(--text-muted);
    font-weight: 500;
  }

  .summary-val {
    color: var(--text-primary);
    font-weight: 700;
  }
</style>
