---
import type { Service } from '../data/services';
import Icon from './Icon.astro';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<article class="service-card card card-glass" id={service.id}>
  <div class="service-card-top">
    <div class="service-num-wrap">
      <span class="service-number">{service.number}</span>
    </div>
    <div class="service-icon-wrap">
      <Icon name={service.icon as any} size={24} class="service-icon" />
    </div>
  </div>

  <div class="service-card-main">
    <h3 class="service-title">{service.title}</h3>
    <p class="service-subtitle">{service.subtitle}</p>
    <p class="service-desc">{service.description}</p>

    <!-- Key Deliverables List -->
    <div class="service-deliverables">
      <h4 class="deliverables-heading">Deliverables Include:</h4>
      <ul class="deliverables-list">
        {service.deliverables.map((item) => (
          <li class="deliverable-item">
            <Icon name="check" size={14} class="check-icon" />
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Tech Stack Pills -->
    <div class="service-tech-tags">
      {service.technologies.map((tech) => (
        <span class="tech-pill">{tech}</span>
      ))}
    </div>
  </div>

  <div class="service-card-footer">
    <div class="timeline-meta">
      <Icon name="clock" size={14} class="meta-icon" />
      <span class="meta-text"><strong>Timeline:</strong> {service.timeline}</span>
    </div>
    <button
      type="button"
      class="btn btn-ghost btn-sm service-inquire-btn open-contact-modal-btn"
      data-contact-trigger
    >
      <span>Inquire</span>
      <Icon name="arrow-right" size={14} />
    </button>
  </div>
</article>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    padding: 2.25rem 2rem;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    background: var(--bg-surface);
    transition: transform var(--transition-normal), border-color var(--transition-normal), box-shadow var(--transition-normal);
  }

  .service-card:hover {
    transform: translateY(-6px);
    border-color: var(--brand-primary);
    box-shadow: 0 16px 36px rgba(99, 102, 241, 0.15);
  }

  .service-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .service-number {
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--brand-primary);
    opacity: 0.8;
  }

  .service-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: rgba(99, 102, 241, 0.12);
    border: 1px solid rgba(99, 102, 241, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-primary);
  }

  .service-card-main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .service-title {
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
    line-height: 1.3;
  }

  .service-subtitle {
    font-size: 0.88rem;
    color: var(--brand-secondary);
    font-weight: 600;
    margin-bottom: 0.85rem;
  }

  .service-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  /* Deliverables */
  .service-deliverables {
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
    margin-bottom: 1.25rem;
  }

  .deliverables-heading {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-subtle);
    margin-bottom: 0.65rem;
  }

  .deliverables-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  .deliverable-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .check-icon {
    color: var(--color-success);
    margin-top: 3px;
  }

  /* Tech tags */
  .service-tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.5rem;
  }

  .tech-pill {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-xs);
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
  }

  /* Footer */
  .service-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .timeline-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .meta-icon {
    color: var(--brand-primary);
  }

  .service-inquire-btn {
    font-weight: 700;
    color: var(--brand-primary);
  }

  .service-inquire-btn:hover {
    color: var(--brand-primary-hover);
  }
</style>
