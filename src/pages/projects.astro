---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProjectsShowcase from '../components/ProjectsShowcase.astro';
import StatsSection from '../components/StatsSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import Icon from '../components/Icon.astro';

const breadcrumbs = [{ label: 'Selected Work' }];
---

<BaseLayout
  title="Selected Work & Case Studies — Apex Agency"
  description="Explore our benchmark digital product architectures, zero-bloat web engineering, and brand identities across deep tech, SaaS, and AI."
>
  <div class="projects-page">
    <div class="container page-header">
      <Breadcrumbs items={breadcrumbs} />
      <span class="section-tag">Case Study Archive</span>
      <h1 class="page-title">Digital Flagships That Shift Market Dynamics.</h1>
      <p class="page-subtitle">
        We partner with venture-backed pioneers and enterprise visionaries. Every case study below represents hundreds of hours of deep user discovery, spatial prototyping, and zero-bloat engineering.
      </p>
    </div>

    <!-- Full Filterable Showcase -->
    <ProjectsShowcase showAll={true} />

    <!-- Agency Metrics -->
    <StatsSection />

    <!-- Client Testimonials -->
    <TestimonialsSection />

    <!-- Bottom Inquiry Callout -->
    <section class="projects-cta-section">
      <div class="container text-center">
        <div class="cta-box card card-glass">
          <span class="badge badge-brand">Initiate Collaboration</span>
          <h2 class="cta-heading">Ready to architect your category-defining product?</h2>
          <p class="cta-text">
            Our directors evaluate incoming briefs each week to ensure every partnership receives unmatched executive focus.
          </p>
          <button type="button" class="btn btn-primary btn-lg btn-glow open-contact-modal-btn" data-contact-trigger>
            <span>Start a Project Inquiry</span>
            <Icon name="arrow-up-right" size={18} />
          </button>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .projects-page {
    padding-top: 2rem;
  }

  .page-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 3rem auto;
  }

  .page-title {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.1;
    margin-bottom: 1.25rem;
    color: var(--text-primary);
  }

  .page-subtitle {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    color: var(--text-muted);
    line-height: 1.65;
  }

  .projects-cta-section {
    padding: 5rem 0 6rem 0;
  }

  .cta-box {
    padding: 3.5rem 2rem;
    max-width: 800px;
    margin: 0 auto;
    border-radius: var(--radius-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .cta-heading {
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .cta-text {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 580px;
    line-height: 1.6;
  }
</style>
