---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import Icon from '../components/Icon.astro';

const breadcrumbs = [{ label: 'Capabilities & Services' }];

const phases = [
  {
    step: '01',
    name: 'Discovery & Product Synthesis',
    timeline: 'Week 1 - 2',
    desc: 'We conduct in-depth customer interviews, map systemic constraints, and define quantitative success milestones before sketching UI.',
    outputs: ['User Journey Maps', 'Architecture Specifications', 'Competitive Differentiation Matrix'],
  },
  {
    step: '02',
    name: 'Spatial Design & Kinetic Prototyping',
    timeline: 'Week 3 - 5',
    desc: 'We explore visual metaphors in high-fidelity Figma canvases, validating micro-interactions, layout ergonomics, and token hierarchies.',
    outputs: ['Interactive Prototypes', 'Design System Foundations', 'Typography & Palette System'],
  },
  {
    step: '03',
    name: 'Zero-Bloat Island Engineering',
    timeline: 'Week 5 - 8',
    desc: 'We develop accessible, lightning-fast web systems using Astro static architecture, TypeScript, and modern CSS modules with zero third-party baggage.',
    outputs: ['Production Repository', 'Automated CI/CD Pipelines', '100/100 Lighthouse Performance'],
  },
  {
    step: '04',
    name: 'Audit, Accessibility & Telemetry',
    timeline: 'Week 8 - 9',
    desc: 'Comprehensive cross-device stress testing, WCAG AAA screen reader audits, privacy-first funnel analytics, and structured SEO schema.',
    outputs: ['Accessibility Audit Signoff', 'Funnel Analytics Dashboard', 'Core Web Vitals Report'],
  },
  {
    step: '05',
    name: 'Launch & Autonomous Handover',
    timeline: 'Week 10',
    desc: 'Zero-downtime deployment orchestration, team training workshops, and comprehensive living documentation so your internal team scales independently.',
    outputs: ['Living Component Hub', 'Recorded Walkthrough Archive', '30-Day Launch Warranty'],
  },
];

const faqs = [
  {
    q: 'How does Apex differ from traditional creative agencies?',
    a: 'We eliminate account managers and junior handoffs. Every project is steered directly by seasoned discipline directors who write code, architect systems, and lead design sprints side-by-side with your executive team.',
  },
  {
    q: 'Why does Apex specialize in Astro for web platforms?',
    a: 'Astro allows us to ship modern component-driven architectures with zero client-side JavaScript by default. This guarantees sub-second page loads, exceptional Lighthouse scores, and effortless SEO dominance without maintenance overhead.',
  },
  {
    q: 'What engagement models do you offer?',
    a: 'We offer three models: Dedicated 6-10 Week Sprints for new product launches/rebrands, Quarterly Engineering Retainers for continuous feature evolution, and Venture Co-Build partnerships for select early-stage teams.',
  },
  {
    q: 'Can our internal engineering team maintain what you build?',
    a: 'Absolutely. We treat developer handoff as a first-class deliverable: clean TypeScript interfaces, zero-dependency CSS, automated GitHub Actions, and living component documentation.',
  },
];
---

<BaseLayout
  title="Capabilities & Services — Apex Agency"
  description="Discover Apex Agency's full-spectrum services: Product Architecture, Next-Gen Web Engineering, Brand Identity, Design Systems, and 3D Canvases."
>
  <div class="services-page">
    <div class="container page-header">
      <Breadcrumbs items={breadcrumbs} />
      <span class="section-tag">Capabilities & Specializations</span>
      <h1 class="page-title">Digital Craft Grounded in Engineering Rigor.</h1>
      <p class="page-subtitle">
        We bridge the divide between visionary brand aesthetics and high-performance technical execution. Here is how we engineer category leadership.
      </p>
    </div>

    <!-- 1. All 6 Interactive Services -->
    <ServicesGrid />

    <!-- 2. Agency 5-Phase Methodology Workflow -->
    <section class="methodology-section">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">Proven Methodology</span>
          <h2 class="section-title">The Apex 5-Phase Delivery Engine.</h2>
          <p class="section-subtitle">
            Every engagement follows a structured, transparent cadence engineered to eliminate guesswork, mitigate technical debt, and ensure launch dates are sacred.
          </p>
        </div>

        <div class="phases-timeline">
          {phases.map((phase) => (
            <div class="phase-card card card-glass">
              <div class="phase-left">
                <span class="phase-step">{phase.step}</span>
                <span class="phase-time">{phase.timeline}</span>
              </div>
              <div class="phase-right">
                <h3 class="phase-title">{phase.name}</h3>
                <p class="phase-desc">{phase.desc}</p>
                <div class="phase-outputs">
                  <span class="outputs-label">Key Artifacts:</span>
                  <div class="outputs-row">
                    {phase.outputs.map((out) => (
                      <span class="output-pill">
                        <Icon name="check" size={12} class="out-icon" />
                        <span>{out}</span>
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 3. Frequently Asked Questions -->
    <section class="faq-section">
      <div class="container container-sm">
        <div class="section-header">
          <span class="section-tag">Common Inquiries</span>
          <h2 class="section-title">Frequently Asked Questions.</h2>
        </div>

        <div class="faq-list">
          {faqs.map((faq) => (
            <details class="faq-item card card-glass">
              <summary class="faq-question">
                <span>{faq.q}</span>
                <span class="faq-toggle-icon">
                  <Icon name="arrow-right" size={16} />
                </span>
              </summary>
              <div class="faq-answer">
                <p>{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Bottom CTA -->
    <section class="services-cta-section">
      <div class="container text-center">
        <div class="cta-box card card-glass">
          <span class="badge badge-brand">Scope Your Project</span>
          <h2 class="cta-heading">Let's talk timelines, deliverables, and budgets.</h2>
          <p class="cta-text">
            Submit your brief or schedule an introductory conversation with our partner directors.
          </p>
          <button type="button" class="btn btn-primary btn-lg btn-glow open-contact-modal-btn" data-contact-trigger>
            <span>Book Discovery Call</span>
            <Icon name="arrow-up-right" size={18} />
          </button>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .services-page {
    padding-top: 2rem;
  }

  .page-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 3rem auto;
  }

  .page-title {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1.1;
    margin-bottom: 1.25rem;
    color: var(--text-primary);
  }

  .page-subtitle {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    color: var(--text-muted);
    line-height: 1.65;
  }

  /* Methodology */
  .methodology-section {
    padding: 6.5rem 0;
  }

  .phases-timeline {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .phase-card {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2.25rem;
    border-radius: var(--radius-xl);
  }

  @media (min-width: 680px) {
    .phase-card {
      flex-direction: row;
      align-items: flex-start;
      gap: 2.5rem;
    }
  }

  .phase-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    min-width: 130px;
  }

  .phase-step {
    font-family: var(--font-mono);
    font-size: 2.2rem;
    font-weight: 900;
    color: var(--brand-primary);
    line-height: 1;
  }

  .phase-time {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-subtle);
  }

  .phase-right {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .phase-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .phase-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .phase-outputs {
    margin-top: 0.5rem;
  }

  .outputs-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-subtle);
    display: block;
    margin-bottom: 0.5rem;
  }

  .outputs-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .output-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    background: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .out-icon {
    color: var(--color-success);
  }

  /* FAQ Section */
  .faq-section {
    padding: 6rem 0;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    border-radius: var(--radius-lg);
    padding: 0;
    overflow: hidden;
    cursor: pointer;
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 1.75rem;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-toggle-icon {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-full);
    background: var(--bg-surface-elevated);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: transform var(--transition-fast);
  }

  details[open] .faq-toggle-icon {
    transform: rotate(90deg);
    color: var(--brand-primary);
  }

  .faq-answer {
    padding: 0 1.75rem 1.5rem 1.75rem;
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.65;
  }

  /* Bottom CTA */
  .services-cta-section {
    padding: 4rem 0 6rem 0;
  }

  .cta-box {
    padding: 3.5rem 2rem;
    max-width: 800px;
    margin: 0 auto;
    border-radius: var(--radius-xl);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .cta-heading {
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
  }

  .cta-text {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 580px;
    line-height: 1.6;
  }
</style>
